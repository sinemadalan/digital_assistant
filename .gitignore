# ============================================================
# DEFAULT: DENY EVERYTHING
# Only explicitly allowed source and configuration files are tracked.
# ============================================================
*


# ============================================================
# ROOT PROJECT FILES
# ============================================================
!.gitignore
!README.md
!LICENSE
!.metadata
!analysis_options.yaml
!pubspec.yaml
!pubspec.lock


# ============================================================
# FLUTTER / DART SOURCE
# ============================================================
!lib/
!lib/**

!test/
!test/**

!integration_test/
!integration_test/**

!assets/
!assets/**


# ============================================================
# PYTHON SERVER SOURCE
# ============================================================
!server/
!server/**

# Python environments and generated caches
server/**/__pycache__/
server/**/*.py[cod]
server/.pytest_cache/
server/.mypy_cache/
server/.ruff_cache/

# Secrets and local configuration
server/**/.env
server/**/.env.*
!server/**/.env.example

# Runtime data containing captured/private information
server/captures.jsonl
server/saved_screenshots/
server/**/*.log
server/**/*.db
server/**/*.sqlite
server/**/*.sqlite3


# ============================================================
# ANDROID PROJECT
# ============================================================
!android/
!android/.gitignore

# Gradle configuration
!android/build.gradle
!android/build.gradle.kts
!android/settings.gradle
!android/settings.gradle.kts
!android/gradle.properties

# Gradle wrapper configuration
!android/gradle/
!android/gradle/wrapper/
!android/gradle/wrapper/gradle-wrapper.properties

# App configuration and sources
!android/app/
!android/app/build.gradle
!android/app/build.gradle.kts
!android/app/src/
!android/app/src/**

# Local Android configuration and signing secrets remain ignored by
# the default deny rule and android/.gitignore:
#   android/local.properties
#   android/key.properties
#   *.jks
#   *.keystore
